{
  "name": "perch",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only multi-account Google Drive + multi-workspace Notion MCP server",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "perch": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "npm run build && vitest run --config vitest.smoke.config.ts",
    "check": "npm run typecheck && npm test && npm run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "imapflow": "^2.2.5",
    "nodemailer": "^10.0.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.19.17",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
