# Perch configuration (names only, no secrets). Copy to .env and adjust; .env is git-ignored.
# Load with: node --env-file=.env dist/cli.js serve --http

# Encrypted credential store directory (default: $XDG_DATA_HOME/perch or ~/.local/share/perch)
PERCH_DATA_DIR=/home/USER/.local/share/perch

# 32-byte store key; MUST be outside PERCH_DATA_DIR (default: ~/.config/perch/store.key). Back it up separately.
PERCH_KEY_FILE=/home/USER/.config/perch/store.key

# File holding the HTTP bearer token, created by `perch init` (default: ~/.config/perch/http-token).
PERCH_HTTP_TOKEN_FILE=/home/USER/.config/perch/http-token
# Alternative: PERCH_HTTP_TOKEN=<token>  (prefer the 0600 token file)

# Bind address: loopback (default) or an explicit Tailscale IP (100.64.0.0/10 or fd7a:115c:a1e0::/48).
PERCH_HTTP_HOST=127.0.0.1
PERCH_HTTP_PORT=8765

# Extra exact Host header values, comma separated (e.g. your Tailscale Serve MagicDNS name).
PERCH_ALLOWED_HOSTS=
# Exact Origin values allowed; any other Origin header is rejected (Claude Code sends none).
PERCH_ALLOWED_ORIGINS=

# Path to the downloaded Google "Desktop app" OAuth client JSON (chmod 600). Needed only for `perch google add`.
PERCH_GOOGLE_CLIENT_FILE=/home/USER/.config/perch/google-client.json

# --- Mail (email milestone) ---
# Gmail uses the same Desktop OAuth client file (PERCH_GOOGLE_CLIENT_FILE); enable the Gmail API in that project.

# Microsoft Graph (Outlook.com / Microsoft 365): Application (client) ID of your Entra app registration
# (platform "Mobile and desktop applications", redirect URI http://localhost). Public client: no secret.
PERCH_MICROSOFT_CLIENT_ID=
# Sign-in tenant: common (default, personal + work), consumers (personal only), organizations, a tenant GUID or domain.
PERCH_MICROSOFT_TENANT=common

# stdio only: token file of a client grant (`perch client add`). Without it, stdio is read-only.
# HTTP clients send their client token as the bearer token instead.
PERCH_CLIENT_TOKEN_FILE=
